APP_NAME="Attendance App"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://YOUR-RAILWAY-APP.up.railway.app

LOG_CHANNEL=stack
LOG_LEVEL=error

# Railway's MySQL plugin injects these automatically if you add it as a
# service and reference it — check the "Variables" tab on your service.
DB_CONNECTION=mysql
DB_HOST=${{MySQL.MYSQLHOST}}
DB_PORT=${{MySQL.MYSQLPORT}}
DB_DATABASE=${{MySQL.MYSQLDATABASE}}
DB_USERNAME=${{MySQL.MYSQLUSER}}
DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}

# Must match your deployed Vercel domain exactly (no protocol, no trailing slash)
SANCTUM_STATEFUL_DOMAINS=your-app.vercel.app
SESSION_DOMAIN=.vercel.app
FRONTEND_URL=https://your-app.vercel.app
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app

GPS_ACCURACY_THRESHOLD=100
