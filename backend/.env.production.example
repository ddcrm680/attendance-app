APP_NAME="Attendance App"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://YOUR-RAILWAY-APP.up.railway.app

LOG_CHANNEL=stack
LOG_LEVEL=error

# Attach a persistent Railway volume at /data. This file must live on that
# volume so deploys do not replace the staging/demo database.
DB_CONNECTION=sqlite
DB_DATABASE=/data/database.sqlite
DB_FOREIGN_KEYS=true
DB_BUSY_TIMEOUT=5000

CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Must match your deployed Vercel domain exactly (no protocol, no trailing slash)
SANCTUM_STATEFUL_DOMAINS=your-app.vercel.app
SESSION_DOMAIN=.vercel.app
FRONTEND_URL=https://your-app.vercel.app
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
LOGIN_RATE_LIMIT=5
SANCTUM_TOKEN_EXPIRATION=

GPS_ACCURACY_THRESHOLD=100

WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=cloud
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v20.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_ATTENDANCE_RECIPIENT=
WHATSAPP_DAILY_REPORT_RECIPIENT=
WHATSAPP_NOTIFY_PUNCH_IN=true
WHATSAPP_NOTIFY_PUNCH_OUT=true
WHATSAPP_NOTIFY_LATE=true
WHATSAPP_RATE_PER_MINUTE=20
WHATSAPP_ATTACH_ATTENDANCE_PHOTO=false
WHATSAPP_DAILY_REPORT_TIME=18:45
QUEUE_CONNECTION=database

# Enable only after retention periods have been approved for this deployment.
PRIVACY_RETENTION_ENABLED=false
ATTENDANCE_PHOTO_RETENTION_DAYS=365
LOCATION_LOG_RETENTION_DAYS=180
PRIVACY_CLEANUP_BATCH_SIZE=250
PRIVACY_CLEANUP_TIME=02:15
SESSION_SECURE_COOKIE=true
