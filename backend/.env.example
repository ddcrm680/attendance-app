APP_NAME="Attendance App"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
DB_FOREIGN_KEYS=true
DB_BUSY_TIMEOUT=5000

CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

SANCTUM_STATEFUL_DOMAINS=localhost:3000
SESSION_DOMAIN=localhost
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
LOGIN_RATE_LIMIT=5
SANCTUM_TOKEN_EXPIRATION=

# GPS accuracy threshold (meters) above which a location reading is rejected
GPS_ACCURACY_THRESHOLD=100

# WhatsApp Business Cloud API (keep these server-side; no values are exposed to the frontend)
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=cloud
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v20.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_ATTENDANCE_RECIPIENT=
WHATSAPP_DAILY_REPORT_RECIPIENT=
WHATSAPP_NOTIFY_PUNCH_IN=true
WHATSAPP_NOTIFY_PUNCH_OUT=true
WHATSAPP_NOTIFY_LATE=true
WHATSAPP_RATE_PER_MINUTE=20
WHATSAPP_ATTACH_ATTENDANCE_PHOTO=false
WHATSAPP_DAILY_REPORT_TIME=18:45

# Sensitive-data retention is opt-in. Set only after approving your policy.
PRIVACY_RETENTION_ENABLED=false
ATTENDANCE_PHOTO_RETENTION_DAYS=365
LOCATION_LOG_RETENTION_DAYS=180
PRIVACY_CLEANUP_BATCH_SIZE=250
PRIVACY_CLEANUP_TIME=02:15
SESSION_SECURE_COOKIE=false
